      "name": "https://sandbox.api.yellowcard.io/business/payments",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const apiKey = '2a10c8cb5b2a22d9ba65645457b4e02a';",
              "const apiSecret = '288d1fb9745f417c7fb29afa8a7bed04c6f07d71b165fcde769ff1ec7168b0a8';",
              "const method = pm.request.method;",
              "const path = '/' + pm.request.url.path.join('/');",
              "const timestamp = new Date().toISOString();",
              "",
              "let message = timestamp + path + method;",
              "",
              "// Pas de hash pour GET",
              "const signature = CryptoJS.HmacSHA256(message, apiSecret);",
              "const signatureBase64 = CryptoJS.enc.Base64.stringify(signature);",
              "",
              "pm.environment.set('timestamp', timestamp);",
              "pm.environment.set('authorizationHeader', `YcHmacV1 ${apiKey}:${signatureBase64}`);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
